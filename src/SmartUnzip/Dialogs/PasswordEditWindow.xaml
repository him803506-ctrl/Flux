<Window x:Class="SmartUnzip.Dialogs.PasswordEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flux — 密码条目" Height="400" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgPrimary}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Text="添加密码"
                   FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1">
            <TextBlock Text="名称：" Style="{StaticResource SubText}" Margin="0,0,0,6" />
            <TextBox x:Name="NameBox" />

            <TextBlock Text="密码：" Style="{StaticResource SubText}" Margin="0,12,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PasswordMasked" Grid.Column="0" Padding="9,7"
                             FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
                             Background="{StaticResource BgCard}"
                             BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" />
                <TextBox x:Name="PasswordPlain" Grid.Column="0" Visibility="Collapsed" />
                <Button Content="显示" Style="{StaticResource SecondaryButton}" Grid.Column="1"
                        Padding="10,7" Margin="8,0,0,0" Click="Toggle_Click" />
            </Grid>

            <TextBlock Text="备注（可选）：" Style="{StaticResource SubText}" Margin="0,12,0,6" />
            <TextBox x:Name="NoteBox" />
        </StackPanel>

        <TextBlock Grid.Row="3" Text="提示：密码使用 Windows DPAPI 加密后存储在本机，不会写入普通配置文件。"
                   Style="{StaticResource MutedText}" TextWrapping="Wrap"
                   VerticalAlignment="Bottom" Margin="0,12,0,0" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Padding="20,8"
                    Click="Cancel_Click" />
            <Button Content="保存" Style="{StaticResource PrimaryButton}" Padding="22,8"
                    Margin="10,0,0,0" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
