<Window x:Class="SmartUnzip.Dialogs.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flux — 需要密码" Height="440" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgPrimary}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="&#x1F510;" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Text="压缩包已加密" FontSize="17" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock x:Name="FileInfoText" Style="{StaticResource SubText}" TextWrapping="Wrap" />
            <TextBlock x:Name="MatchResultText" Style="{StaticResource SubText}"
                       Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Warning}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="请输入解压密码：" Style="{StaticResource SubText}" Margin="0,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PasswordMasked" Grid.Column="0" Padding="9,7"
                             FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
                             Background="{StaticResource BgCard}"
                             BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" />
                <TextBox x:Name="PasswordBox" Grid.Column="0" Visibility="Collapsed" />
                <Button x:Name="BtnToggle" Grid.Column="1" Content="显示" Style="{StaticResource SecondaryButton}"
                        Padding="10,7" Margin="8,0,0,0" Click="BtnToggle_Click" />
            </Grid>
            <CheckBox x:Name="ChkShow" Content="显示密码" Margin="0,8,0,0"
                      Checked="ChkShow_Changed" Unchecked="ChkShow_Changed" />
        </StackPanel>

        <Border Grid.Row="3" Background="{StaticResource BgSubtle}" CornerRadius="8"
                Padding="14" VerticalAlignment="Top">
            <StackPanel>
                <CheckBox x:Name="ChkRememberSession" Content="本次任务中记住密码（程序关闭后清除）" />
                <CheckBox x:Name="ChkSave" Content="保存到密码库" Margin="0,6,0,0"
                          Checked="ChkSave_Changed" Unchecked="ChkSave_Changed" />
                <StackPanel x:Name="SaveFields" Margin="24,6,0,0" Visibility="Collapsed">
                    <TextBlock Text="密码名称：" Style="{StaticResource SubText}" Margin="0,2,0,4" />
                    <TextBox x:Name="EntryNameBox" />
                    <TextBlock Text="备注（可选）：" Style="{StaticResource SubText}" Margin="0,8,0,4" />
                    <TextBox x:Name="EntryNoteBox" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Padding="20,8"
                    Click="Cancel_Click" />
            <Button Content="解压" Style="{StaticResource PrimaryButton}" Padding="22,8"
                    Margin="10,0,0,0" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
