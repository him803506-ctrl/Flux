<Window x:Class="SmartUnzip.Dialogs.VaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flux — 密码库" Height="580" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgPrimary}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="密码库" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="VaultSubtitle" Style="{StaticResource SubText}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="+ 添加密码" Style="{StaticResource PrimaryButton}" Padding="14,7"
                        Click="Add_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"
                     Tag="搜索密码名称或备注…" />
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <TextBlock x:Name="EmptyHint" Text="密码库为空。点击右上角「添加密码」开始建立。"
                           Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ItemsControl x:Name="EntryList" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgSubtle}" CornerRadius="8"
                                        Padding="14,12" Margin="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding MaskedPassword}" FontFamily="Consolas"
                                                       Style="{StaticResource SubText}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding MetaText}" Style="{StaticResource MutedText}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Content="显示" Style="{StaticResource LinkButton}"
                                                    Tag="{Binding}" Click="Reveal_Click" />
                                            <Button Content="复制" Style="{StaticResource LinkButton}"
                                                    Tag="{Binding}" Click="Copy_Click" />
                                            <Button Content="编辑" Style="{StaticResource LinkButton}"
                                                    Tag="{Binding}" Click="Edit_Click" />
                                            <Button Content="删除" Style="{StaticResource LinkButton}"
                                                    Foreground="{StaticResource Danger}"
                                                    Tag="{Binding}" Click="Delete_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="密码库使用 Windows DPAPI 加密存储，配置文件打开为密文。"
                       Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <Button Content="关闭" Style="{StaticResource SecondaryButton}" Padding="20,8"
                    HorizontalAlignment="Right" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
