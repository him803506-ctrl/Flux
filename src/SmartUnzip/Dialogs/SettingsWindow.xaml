<Window x:Class="SmartUnzip.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flux — 设置" Height="680" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgPrimary}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 常规 -->
                <TextBlock Text="常规" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="默认解压目录" Style="{StaticResource SubText}" Margin="0,0,0,8" />
                        <RadioButton x:Name="RbSource" Content="原文件所在目录" GroupName="OutDir"
                                     Margin="0,2,0,4" Checked="OutMode_Changed" />
                        <RadioButton x:Name="RbCustom" Content="自定义目录" GroupName="OutDir"
                                     Margin="0,2,0,8" Checked="OutMode_Changed" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CustomDirBox" Grid.Column="0" />
                            <Button Content="浏览…" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                    Padding="14,7" Margin="8,0,0,0" Click="Browse_Click" />
                        </Grid>

                        <CheckBox x:Name="ChkKeep" Content="保留原始文件（推荐）" Margin="0,14,0,0" />
                        <CheckBox x:Name="ChkOpenFolder" Content="解压完成后打开目标文件夹" />
                        <CheckBox x:Name="ChkAutoMulti" Content="自动处理拖入的多个文件" />

                        <TextBlock Text="输出目录已存在时" Style="{StaticResource SubText}" Margin="0,12,0,6" />
                        <RadioButton x:Name="RbNewFolder" Content="创建新目录（推荐）" GroupName="Collision"
                                     Margin="0,2,0,4" />
                        <RadioButton x:Name="RbReuse" Content="使用已有目录" GroupName="Collision" Margin="0,2,0,4" />
                    </StackPanel>
                </Border>

                <!-- 解压引擎 -->
                <TextBlock Text="解压引擎" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="当前核心引擎：7-Zip" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock x:Name="EngineStatusText" Style="{StaticResource SubText}"
                                   Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="EnginePathText" Style="{StaticResource MutedText}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                        <Button Content="重新检测" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Padding="14,7" Margin="0,12,0,0"
                                Click="Redetect_Click" />
                    </StackPanel>
                </Border>

                <!-- 密码 -->
                <TextBlock Text="密码" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                    <StackPanel>
                        <CheckBox x:Name="ChkAutoMatch" Content="自动匹配密码" />
                        <CheckBox x:Name="ChkRememberSession" Content="本次任务记住密码" />
                        <TextBlock Text="密码匹配顺序" Style="{StaticResource SubText}" Margin="0,12,0,6" />
                        <RadioButton x:Name="RbRecent" Content="最近使用优先" GroupName="MatchOrder"
                                     Margin="0,2,0,4" />
                        <RadioButton x:Name="RbOrder" Content="密码库顺序" GroupName="MatchOrder" Margin="0,2,0,4" />
                        <TextBlock x:Name="VaultInfoText" Style="{StaticResource MutedText}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- 系统 -->
                <TextBlock Text="系统" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                    <StackPanel>
                        <CheckBox x:Name="ChkContextMenu" Content="启用 Windows 右键菜单（「使用 Flux 解压」）" />
                        <CheckBox x:Name="ChkStartup" Content="开机启动" />
                        <CheckBox x:Name="ChkLogging" Content="记录日志" Margin="0,8,0,0" />
                        <Button Content="打开日志目录" Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Left" Margin="0,8,0,0" Click="OpenLog_Click" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Padding="20,8"
                    Click="Cancel_Click" />
            <Button Content="保存" Style="{StaticResource PrimaryButton}" Padding="22,8"
                    Margin="10,0,0,0" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
